<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0"
  demote-non-dropping-particle="never" default-locale="fr-FR">
  <info>
    <title>ISO-690 (numeric, Français) - modifié par Chris Mann</title>
    <id>http://www.zotero.org/styles/iso690-numeric-fr</id>
    <link href="http://www.zotero.org/styles/iso690-numeric-fr" rel="self"/>
    <link href="https://forums.zotero.org/discussion/23511" rel="documentation"/>
    <author>
      <name>Laure Mellifluo</name>
      <email>laure.melli@gmail.com</email>
    </author>
    <author>
      <name>Raphael Grolimund</name>
      <email>grolimur@protonmail.ch</email>
    </author>
    <author>
      <name>Michel Hardegger</name>
      <email>hardegger@gmail.com</email>
    </author>
    <category citation-format="label"/>
    <category field="generic-base"/>
    <summary>Style based on ISO 690:2010(F), V1.1</summary>
    <updated>2022-03-24T00:29:32+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale>
    <terms>
      <term name="no date">[sans date]</term>
      <term name="in">in</term>
      <term name="online">en&#160;ligne</term>
      <term name="accessed">consulté&#160;le</term>
      <term name="retrieved">disponible</term>
      <term name="from">à l'adresse</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author">
      <name and="text" name-as-sort-order="all" sort-separator=", " delimiter=", " delimiter-precedes-last="never">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given"/>
      </name>
    </names>
  </macro>
  <macro name="editor">
    <names variable="editor">
      <name and="text" name-as-sort-order="all" sort-separator=", " delimiter=", " delimiter-precedes-last="never">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given"/>
      </name>
      <label prefix=" (" form="short" suffix=".)"/>
    </names>
  </macro>
  <macro name="language">
    <text variable="language"/>
  </macro>
  <macro name="translator">
    <names variable="translator">
      <name and="text" name-as-sort-order="all" sort-separator=", " delimiter=", " delimiter-precedes-last="never">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given"/>
      </name>
    </names>
  </macro>
  <macro name="translator">
    <names variable="translator">
      <name and="text" name-as-sort-order="all" sort-separator=", " delimiter=", " delimiter-precedes-last="never">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given"/>
      </name>
      <label prefix=" (" form="short" suffix=".)"/>
    </names>
  </macro>
  <macro name="responsability">
    <choose>
      <if variable="author editor translator" match="any">
        <choose>
          <if variable="author">
            <text macro="author"/>
          </if>
          <else-if variable="editor">
            <text macro="editor"/>
          </else-if>
          <else>
            <text macro="translator"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="container-author">
    <names variable="container-author">
      <name and="text" name-as-sort-order="all" sort-separator=", " delimiter=", " delimiter-precedes-last="never">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given"/>
      </name>
    </names>
  </macro>
  <macro name="container-responsability">
    <choose>
      <if variable="container-author editor translator" match="any">
        <choose>
          <if variable="container-author">
            <text macro="container-author"/>
          </if>
          <else-if variable="editor">
            <text macro="editor"/>
          </else-if>
          <else>
            <text macro="translator"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="year-date">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year" form="long"/>
        </date>
      </if>
      <else>
        <text term="no date"/>
      </else>
    </choose>
  </macro>
  <macro name="title">
    <text variable="title"/>
  </macro>
  <!-- <macro name="title">
    <text variable="title" font-style="italic" suffix="."/>
    <choose>
      <if variable="URL">
        <text term="online" prefix=" [" suffix="]"/>
      </if>
    </choose> 
  </macro> -->
  <macro name="medium">
    <text variable="medium"/>
  </macro>
  <!-- <macro name="type">
    <text variable="type"/>
  </macro> -->
  <macro name="genre">
    <text variable="genre"/>
  </macro>
  <macro name="date">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="short" suffix=" "/>
          <date-part name="year"/>
        </date>
      </if>
    </choose>
  </macro>
  <macro name="edition">
    <text variable="edition" form="long"/>
  </macro>
  <macro name="publisher-group">
    <group delimiter="&#160;: ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>
  <macro name="issue">
    <group delimiter=", ">
      <text variable="volume" prefix="Vol.&#160;"/>
      <choose>
        <if variable="volume">
          <text variable="issue" prefix="n°&#160;"/>
          <text variable="page" prefix="pp.&#160;"/>
        </if>
        <else-if variable="issue">
          <text variable="issue" prefix="N°&#160;"/>
          <text variable="page" prefix="pp.&#160;"/>
        </else-if>
        <else>
          <text variable="page" prefix="issue.&#160;"/>
        </else>
      </choose>
    </group>
  </macro>
  <macro name="accessed">
    <choose>
      <if variable="URL">
        <group>
          <text term="accessed" text-case="capitalize-first"/>
          <date variable="accessed">
            <date-part name="day" prefix="&#160;"/>
            <date-part name="month" form="short" prefix="&#160;"/>
            <date-part name="year" prefix="&#160;"/>
          </date>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="collection">
    <group delimiter=", ">
      <text variable="collection-title"/>
      <text variable="collection-number"/>
    </group>
  </macro>
  <macro name="page">
    <text variable="page" prefix="page(s)&#160;"/>
  </macro>
  <macro name="isbn">
    <text variable="ISBN" prefix="ISBN&#160;"/>
  </macro>
  <macro name="keyword">
    <text variable="keyword"/>
  </macro>
  <macro name="annote">
    <text variable="annote"/>
  </macro>
  <macro name="doi">
    <text variable="DOI" prefix="DOI&#160;"/>
  </macro>
  <macro name="url">
    <choose>
      <if variable="DOI" match="none">
        <choose>
          <if variable="URL">
            <group>
              <text variable="URL"/>
            </group>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="archive" >
    <group delimiter=":&#160;">
      <text variable="archive"/>
      <text macro="archive_location"/>
    </group>
  </macro>
  <macro name="archive_location">
    <choose>
      <if variable="archive_location">
        <text variable="archive_location"/>
      </if>
      <else>
        <text variable="call-number"/>
      </else>
    </choose>
  </macro>
  <macro name="email">
    <text variable="email"/>
  </macro>
  <macro name="file">
    <text variable="file" />
  </macro>
  <macro name="abstract">
    <text variable="abstract"/>
  </macro> 
  <macro name="note">
    <text variable="note"/>
  </macro>
  <macro name="number">
    <text variable="number"/>
  </macro>
  <macro name="groupannote">
    <choose>
      <if variable="annote">
        <group display="block">
          <text macro="annote" font-weight="light" suffix="&#160;&#160;"/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="groupnumber">
    <choose>
      <if variable="number">
        <group display="block">
          <text macro="number" font-weight="light" suffix="&#160;&#160;"/>
        </group>
      </if>
    </choose>
  </macro>
  <citation disambiguate-add-year-suffix="true">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
    </sort>
    <layout prefix=" [" suffix="]" text-decoration="underline" delimiter=", ">
      <!-- <layout prefix=" (" suffix=")" delimiter=", "> -->
      <group delimiter=", ">
        <text variable="citation-label"/>
        <group>
          <label variable="locator" suffix=".&#160;" form="long" strip-periods="true"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>
  <bibliography>
    <sort>
      <key macro="date" sort="descending"/>
      <!-- <key macro="author"/> -->
      <!-- <key variable="number" sort="descending"/> -->
    </sort>
    <layout>
      <group display="block">
        <group display="right-inline">
          <text variable="citation-label" text-decoration="underline" />
          <!-- <text variable="citation-label" text-decoration="underline" prefix="["
            suffix="]&#160;&#160; "/> -->  
        </group>
        <group display="left-margin">
          <text macro="date" form="short" font-style="none" font-weight="normal"/>
        </group>
        <group display="left-margin">
          <text macro="genre" prefix="" suffix="&#160; "/>
          <text macro="groupnumber" font-weight="light" prefix="(" suffix=")&#160;&#160;"/>
          <group display="block">
            <text macro="keyword" font-weight="light" font-style="italic" suffix="&#160;&#160;"/>
          </group>
          <!-- <text macro="groupannote"/> -->
        </group>
        <group display="right-inline">
          <text macro="responsability" font-weight="normal" prefix=" " suffix=".&#160; "/>
          <text macro="title" font-style="italic" font-weight="normal" prefix="" suffix=".&#160; "/>
          <group display="block">
            <text macro="edition" font-weight="light" text-decoration="underline" prefix="./annexes/"/>
            <group display="block">
              <!-- <text macro="genre" prefix=" " suffix="&#160; "/> -->
              <!-- <text macro="number" prefix=" " suffix="&#160; "/> -->
              <!-- <text macro="medium" prefix=" " suffix=".&#160; "/> -->
              <!-- <text macro="language" prefix=" (lang: " suffix=")&#160; "/> -->
              <!-- <text macro="page" prefix=" (page(s): " suffix=")&#160; "/>  -->
              <text variable="publisher" prefix="(Publication: " suffix=").&#160; "/>
              <!-- <text macro="publisher-group" prefix="(" suffix=")&#160; "/>  -->
              <!-- <text macro="translator" prefix=" " suffix=".&#160; "/>  -->
              <!-- <text macro="issue" prefix=" " suffix=".&#160; "/> -->
              <!-- <text macro="accessed" prefix=" " suffix=".&#160; "/> -->
              <!-- <text macro="doi" prefix=" " suffix=".&#160; "/> -->
              <!-- <text macro="collection" prefix=" (collection: " suffix=")&#160; "/> -->
              <!-- <text macro="isbn" prefix=" " suffix=".&#160; "/> -->
              <!-- <text macro="archive" prefix=" " suffix=".&#160; "/> -->
              <!-- <text macro="keyword" font-weight="light" prefix=". (" suffix=").&#160; "/> -->
              <!-- <text macro="abstract" prefix=" (Synthèse: " suffix=").&#160; "/> -->
              <text macro="email" prefix="(Email: " suffix=").&#160; "/>
              <!-- <text variable="file" prefix=" " suffix=".&#160; "/> -->
              <text macro="url" prefix=" (URL: " suffix=").&#160; "/> 
              <text macro="annote" font-weight="light" font-style="italic" prefix="[Annotation: " suffix="].&#160; "/>
              <text macro="note" font-style="italic" font-weight="light" prefix="[Note: " suffix="].&#160; "/>
              <text macro="abstract" font-style="italic" font-weight="light" prefix="[Résumé: " suffix="].&#160;"/>
            </group>
          </group>
        </group>
      </group>
    </layout>
  </bibliography>
</style>